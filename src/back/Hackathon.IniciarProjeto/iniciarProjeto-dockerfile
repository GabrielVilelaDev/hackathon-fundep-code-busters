# Usar a imagem oficial do .NET 8 SDK para build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar arquivos de projeto e restaurar depend�ncias
COPY ["Hackathon.IniciarProjeto.Api/Hackathon.IniciarProjeto.Api.csproj", "Hackathon.IniciarProjeto.Api/"]
COPY ["Hackathon.IniciarProjeto.Application/Hackathon.IniciarProjeto.Application.csproj", "Hackathon.IniciarProjeto.Application/"]
COPY ["Hackathon.IniciarProjeto.Domain/Hackathon.IniciarProjeto.Domain.csproj", "Hackathon.IniciarProjeto.Domain/"]
COPY ["Hackathon.IniciarProjeto.Infrastructure/Hackathon.IniciarProjeto.Infrastructure.csproj", "Hackathon.IniciarProjeto.Infrastructure/"]

RUN dotnet restore "Hackathon.IniciarProjeto.Api/Hackathon.IniciarProjeto.Api.csproj"

# Copiar todo o c�digo fonte
COPY . .

# Build da aplica��o
WORKDIR "/src/Hackathon.IniciarProjeto.Api"
RUN dotnet build "Hackathon.IniciarProjeto.Api.csproj" -c Release -o /app/build

# Publicar a aplica��o
RUN dotnet publish "Hackathon.IniciarProjeto.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Usar a imagem runtime do .NET 8 para execu��o
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Instalar certificados SSL, curl para health check e configurar timezone
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Configurar timezone para S�o Paulo
ENV TZ=America/Sao_Paulo

# Criar usu�rio n�o-root para seguran�a
RUN addgroup --system --gid 1001 appgroup \
    && adduser --system --uid 1001 --gid 1001 --no-create-home appuser

# Copiar arquivos publicados
COPY --from=build /app/publish .

# Alterar propriet�rio dos arquivos
RUN chown -R appuser:appgroup /app

# Mudar para usu�rio n�o-root
USER appuser

# Configurar vari�veis de ambiente
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Expor porta
EXPOSE 8080

# Configurar health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Comando de inicializa��o
ENTRYPOINT ["dotnet", "Hackathon.IniciarProjeto.Api.dll"]